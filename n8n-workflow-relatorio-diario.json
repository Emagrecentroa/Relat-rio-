            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"number\": \"5522981598727\", \"text\": $json.mensagem } }}"
      },
      "id": "enviar-resumo",
      "name": "Enviar resumo (texto)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
