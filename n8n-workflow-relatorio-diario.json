{
  "name": "[PROD][RELATORIO-DIARIO-EMAGRECENTRO][V2]",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 19 * * *"
            }
          ]
        }
      },
      "id": "trigger-19h",
      "name": "Todo dia às 19h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const tz = 'America/Sao_Paulo';\nconst hoje = new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());\nreturn [{ json: { hoje } }];"
      },
      "id": "data-hoje",
      "name": "Calcular data de hoje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://firestore.googleapis.com/v1/projects/aniversariantes-emagrecentro/databases/(default)/documents/relatorios_diarios/{{ $json.hoje }}/entradas",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "buscar-relatorio",
      "name": "Buscar lançamentos do dia (Firestore)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst docs = body.documents || [];\n\nif (docs.length === 0) {\n  return [{ json: { temEntradas: false, mensagem: null, fotos: [] } }];\n}\n\nconst entradas = docs.map((d) => {\n  const f = d.fields || {};\n  return {\n    hora: f.hora ? f.hora.stringValue : '',\n    tipo: f.tipo ? f.tipo.stringValue : '',\n    texto: f.texto ? f.texto.stringValue : '',\n    supervisora: f.supervisora ? f.supervisora.stringValue : '',\n    fotoUrl: f.fotoUrl && f.fotoUrl.stringValue ? f.fotoUrl.stringValue : null\n  };\n}).sort((a, b) => a.hora.localeCompare(b.hora));\n\nconst dataFormatada = new Date().toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n\nlet msg = `*Relatório Diário — Emagrecentro*\\n_${dataFormatada}_\\n\\n`;\nfor (const e of entradas) {\n  const autor = e.supervisora ? ` — ${e.supervisora}` : '';\n  msg += `🔸 *${e.hora}* [${e.tipo}]${autor}\\n${e.texto}`;\n  if (e.fotoUrl) msg += `\\n📷 foto em anexo logo abaixo`;\n  msg += `\\n\\n`;\n}\nmsg += `Total de registros: ${entradas.length}`;\n\nconst fotos = entradas\n  .filter((e) => e.fotoUrl)\n  .map((e) => ({ url: e.fotoUrl, legenda: `${e.hora} — ${e.tipo} (${e.supervisora}): ${e.texto}` }));\n\nreturn [{ json: { temEntradas: true, mensagem: msg, fotos } }];"
      },
      "id": "montar-mensagem",
      "name": "Montar mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.temEntradas }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "tem-entradas",
      "name": "Teve algo pra reportar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://evo.assistentemoderno.com.br/message/sendText/moderno.club",
