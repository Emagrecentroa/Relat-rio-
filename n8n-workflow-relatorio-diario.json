{
  "name": "[PROD][RELATORIO-DIARIO-EMAGRECENTRO][V1]",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 19 * * *"
            }
          ]
        }
      },
      "id": "trigger-19h",
      "name": "Todo dia às 19h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const tz = 'America/Sao_Paulo';\nconst hoje = new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());\nreturn [{ json: { hoje } }];"
      },
      "id": "data-hoje",
      "name": "Calcular data de hoje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "=https://firestore.googleapis.com/v1/projects/COLE_SEU_PROJECT_ID/databases/(default)/documents/relatorios_diarios/{{ $json.hoje }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "buscar-relatorio",
      "name": "Buscar relatório do dia (Firestore)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst fields = body.fields;\n\nif (!fields || !fields.entradas || !fields.entradas.arrayValue || !fields.entradas.arrayValue.values) {\n  return [{ json: { temEntradas: false, mensagem: null } }];\n}\n\nconst entradas = fields.entradas.arrayValue.values.map((v) => {\n  const m = v.mapValue.fields;\n  return {\n    hora: m.hora.stringValue,\n    tipo: m.tipo.stringValue,\n    texto: m.texto.stringValue\n  };\n}).sort((a, b) => a.hora.localeCompare(b.hora));\n\nconst dataFormatada = new Date().toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n\nlet msg = `*Relatório Diário — Emagrecentro*\\n_${dataFormatada}_\\n\\n`;\nfor (const e of entradas) {\n  msg += `🔸 *${e.hora}* [${e.tipo}]\\n${e.texto}\\n\\n`;\n}\nmsg += `Total de registros: ${entradas.length}`;\n\nreturn [{ json: { temEntradas: true, mensagem: msg } }];"
      },
      "id": "montar-mensagem",
      "name": "Montar mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.temEntradas }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "tem-entradas",
      "name": "Teve algo pra reportar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://evo.assistentemoderno.com.br/message/sendText/moderno.club",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "COLE_SUA_EVOLUTION_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"number\": \"5522981598727\", \"text\": $json.mensagem } }}"
      },
      "id": "enviar-whatsapp",
      "name": "Enviar WhatsApp (Evolution API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, -80]
    }
  ],
  "connections": {
    "Todo dia às 19h": {
      "main": [[{ "node": "Calcular data de hoje", "type": "main", "index": 0 }]]
    },
    "Calcular data de hoje": {
      "main": [[{ "node": "Buscar relatório do dia (Firestore)", "type": "main", "index": 0 }]]
    },
    "Buscar relatório do dia (Firestore)": {
      "main": [[{ "node": "Montar mensagem", "type": "main", "index": 0 }]]
    },
    "Montar mensagem": {
      "main": [[{ "node": "Teve algo pra reportar?", "type": "main", "index": 0 }]]
    },
    "Teve algo pra reportar?": {
      "main": [
        [{ "node": "Enviar WhatsApp (Evolution API)", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": {
    "timezone": "America/Sao_Paulo"
  }
}
